# Contact form. Get a key at https://resend.com — the free tier is enough.
RESEND_API_KEY=

# Optional: only once you have verified a sending domain in Resend.
# Without it the form sends from Resend's shared onboarding@resend.dev address,
# which delivers to the Resend account owner — i.e. the right inbox anyway.
CONTACT_FROM_EMAIL=

# Canonical origin, used for metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://miladkarandish.vercel.app
